# ==============================================================================
# 🌐 APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3010
API_PORT=3010

# Número máximo de inscritos permitidos para o Connect 2026
MAX_REGISTRATIONS=200

# Origens permitidas no CORS (separadas por vírgula)
FRONTEND_URL="http://localhost:5173,http://localhost:3000"

# ==============================================================================
# 🗄️ DATABASE (PostgreSQL & Prisma)
# ==============================================================================
POSTGRES_USER=connect
POSTGRES_PASSWORD=connect_dev_password
POSTGRES_DB=connect2026
POSTGRES_PORT=5432

DATABASE_URL="postgresql://connect:connect_dev_password@localhost:5432/connect2026?schema=public"

# ==============================================================================
# 🔐 SECURITY & QR TICKETS
# ==============================================================================
# Chave secreta usada para assinar o QR Code de cada convite (mín. 32 chars)
TICKET_SECRET="change-me-to-a-secure-random-ticket-secret-min-32-chars"

# Chave para validar check-in na entrada do evento (POST /api/checkin)
ADMIN_API_KEY="change-me-to-a-secure-admin-checkin-key"

# ==============================================================================
# ✉️ EMAIL SERVICE (Resend ou SMTP)
# ==============================================================================
# Opção 1: Resend (recomendado em produção, padrão med-project-api)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Connect 2026 <convites@seudominio.com>"

# Opção 2: SMTP (ex.: Brevo, Gmail, servidor próprio)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Connect 2026 <convites@seudominio.com>"
