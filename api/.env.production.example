# ==============================================================================
# 🚀 PRODUCTION ENVIRONMENT (DOKPLOY / VPS)
# ==============================================================================
NODE_ENV=production
PORT=3010

# Limite máximo de inscritos
MAX_REGISTRATIONS=200

# Domínio público do frontend (CORS)
FRONTEND_URL="https://connect2026.seudominio.com"

# PostgreSQL (usado pelo container postgres e para derivar DATABASE_URL)
POSTGRES_USER=connect_prod
POSTGRES_PASSWORD="SUBSTITUA_POR_PASSWORD_FORTE"
POSTGRES_DB=connect2026

# Segurança dos QR Codes e Check-in
TICKET_SECRET="SUBSTITUA_POR_CHAVE_SECRETA_COM_PELO_MENOS_32_CARACTERES"
ADMIN_API_KEY="SUBSTITUA_POR_CHAVE_ADMIN_PARA_CHECKIN"

# E-mail transaccional (preencha Resend OU SMTP)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Connect 2026 <convites@seudominio.com>"

SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Connect 2026 <convites@seudominio.com>"
